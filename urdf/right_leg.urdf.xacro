<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Non-foot visual and collision geometry use independent mesh files and share one editable transform. -->
  <xacro:macro name="right_link_mesh" params="visual_filename collision_filename xyz rpy scale material">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><mesh filename="${visual_filename}" scale="${scale}"/></geometry>
      <material name="${material}"/>
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><mesh filename="${collision_filename}" scale="${scale}"/></geometry>
    </collision>
  </xacro:macro>

  <!-- Right-side counterpart of the six degree-of-freedom left leg. -->
  <xacro:macro name="right_leg" params="parent hip_y link1_z upper_leg_length lower_leg_length foot_length foot_width foot_height foot_collision_width">
    <!-- EDITABLE: Link 1 is the fixed leg mount; mesh xyz/rpy values are safe zeroed starting points. -->
    <link name="right_link1">
      <xacro:right_link_mesh visual_filename="package://openleg_description/meshes/right_leg/Right_Link1.stl" collision_filename="package://openleg_description/meshes/right_leg/Right_Link1.stl" xyz="0 0 0" rpy="${pi / 2} 0 ${pi / 2}" scale="1 1 1" material="right_leg_red"/>
      <!-- CAD mass: 1.674577 kg, plus 0.5 kg for bolts and wires.
           CAD X/Y/Z map to URDF Y/Z/X; CAD and link origins coincide.
           Inertia at COM is converted from g mm^2 to kg m^2, then scaled
           assuming the added mass follows the CAD mass distribution; COM is unchanged. -->
      <xacro:property name="right_link1_inertia_scale" value="${(1.674577 + 0.5) / 1.674577}"/>
      <inertial>
        <origin xyz="0.029177 -0.000018 -0.001849" rpy="0 0 0"/>
        <mass value="${1.674577 + 0.5}"/>
        <inertia ixx="${0.003013000000 * right_link1_inertia_scale}" ixy="${-0.000000570932 * right_link1_inertia_scale}" ixz="${-0.000074828761 * right_link1_inertia_scale}"
                 iyy="${0.001887000000 * right_link1_inertia_scale}" iyz="${-0.000000030342 * right_link1_inertia_scale}" izz="${0.002170000000 * right_link1_inertia_scale}"/>
      </inertial>
    </link>
    <joint name="right_base_fixed_joint" type="fixed">
      <parent link="${parent}"/><child link="right_link1"/>
      <origin xyz="0 ${hip_y} ${link1_z}" rpy="0 0 -1.57"/>
    </joint>
    <link name="right_link2">
      <xacro:right_link_mesh visual_filename="package://openleg_description/meshes/right_leg/Right_Link2.stl" collision_filename="package://openleg_description/meshes/right_leg/Right_Link2.stl" xyz="0 0 0" rpy="0 0 0" scale="1 1 1" material="right_leg_red"/>
      <!-- CAD mass: 1.760088 kg, plus 0.5 kg for bolts and wires.
           CAD X/Y/Z map to URDF X/Z/-Y; CAD and link origins coincide.
           Inertia at COM is converted from g mm^2 to kg m^2, then scaled
           assuming the added mass follows the CAD mass distribution; COM is unchanged. -->
      <xacro:property name="right_link2_inertia_scale" value="${(1.760088 + 0.5) / 1.760088}"/>
      <inertial>
        <origin xyz="0.001703 0.056011 0.048374" rpy="0 0 0"/>
        <mass value="${1.760088 + 0.5}"/>
        <inertia ixx="${0.003362000000 * right_link2_inertia_scale}" ixy="${-0.000012697179 * right_link2_inertia_scale}" ixz="${-0.000018817964 * right_link2_inertia_scale}"
                 iyy="${0.002249000000 * right_link2_inertia_scale}" iyz="${-0.000324300000 * right_link2_inertia_scale}" izz="${0.002256000000 * right_link2_inertia_scale}"/>
      </inertial>
    </link>
    <!-- J1: hip pitch, Link1 -> Link2 -->
    <joint name="right_joint1" type="revolute">
      <parent link="right_link1"/><child link="right_link2"/>
      <origin xyz="0.064 0 0" rpy="0 ${pi} -${pi / 2}"/><axis xyz="0 1 0"/>
      <limit lower="${-90 * pi / 180}" upper="${90 * pi / 180}" effort="40" velocity="5.23599"/>
      <dynamics damping="2.0" friction="0.05"/>
    </joint>

    <link name="right_link3">
      <xacro:right_link_mesh visual_filename="package://openleg_description/meshes/right_leg/Link3.stl" collision_filename="package://openleg_description/meshes/right_leg/Link3.stl" xyz="0 0 0" rpy="0 0 ${pi / 2}" scale="1 1 1" material="joint_dark"/>
      <inertial><origin xyz="0.001837 0 0.044592"/><mass value="0.25"/><inertia ixx="0.000271316138" ixy="0" ixz="-0.000060712575" iyy="0.000291319338" iyz="0" izz="0.000136870384"/></inertial>
    </link>
    <!-- J2: hip roll, Link2 -> Link3 -->
    <joint name="right_joint2" type="revolute">
      <parent link="right_link2"/><child link="right_link3"/><origin xyz="-0.027 0.060 0.055" rpy="0 0 0"/><axis xyz="1 0 0"/>
      <limit lower="${-60 * pi / 180}" upper="${30 * pi / 180}" effort="40" velocity="5.23599"/>
      <dynamics damping="2.0" friction="0.05"/>
    </joint>

    <link name="right_link4">
      <xacro:right_link_mesh visual_filename="package://openleg_description/meshes/right_leg/Right_Link4.stl" collision_filename="package://openleg_description/meshes/right_leg/Right_Link4.stl" xyz="0 0 0" rpy="-${pi / 2} 0 -${pi / 2}" scale="1 1 1" material="right_leg_red"/>
      <!-- CAD mass: 2.826622 kg, plus 0.5 kg for bolts and wires.
           CAD X/Y/Z map to URDF -Y/X/Z; CAD and link origins coincide.
           Inertia at COM is converted from g mm^2 to kg m^2, then scaled
           assuming the added mass follows the CAD mass distribution; COM is unchanged. -->
      <xacro:property name="right_link4_inertia_scale" value="${(2.826622 + 0.5) / 2.826622}"/>
      <inertial>
        <origin xyz="-0.000012 -0.015481 0.108918" rpy="0 0 0"/>
        <mass value="${2.826622 + 0.5}"/>
        <inertia ixx="${0.010770000000 * right_link4_inertia_scale}" ixy="${-0.000000610697 * right_link4_inertia_scale}" ixz="${-0.000024502364 * right_link4_inertia_scale}"
                 iyy="${0.011520000000 * right_link4_inertia_scale}" iyz="${0.000848900000 * right_link4_inertia_scale}" izz="${0.003316000000 * right_link4_inertia_scale}"/>
      </inertial>
    </link>
    <!-- J3: hip yaw, Link3 -> Link4 -->
    <joint name="right_joint3" type="revolute">
      <parent link="right_link3"/><child link="right_link4"/><origin xyz="0.027 0 0.074" rpy="0 0 0"/><axis xyz="0 0 1"/>
      <limit lower="-${pi / 2}" upper="${pi / 2}" effort="30" velocity="4.18879"/>
      <dynamics damping="2.5" friction="0.05"/>
    </joint>

    <link name="right_link5">
      <xacro:right_link_mesh visual_filename="package://openleg_description/meshes/right_leg/Right_Link5.stl" collision_filename="package://openleg_description/meshes/right_leg/Right_Link5.stl" xyz="0 0 0" rpy="0 -${pi / 2} 0" scale="1 1 1" material="right_leg_red"/>
      <!-- CAD mass: 2.580937 kg, plus 0.5 kg for bolts and wires.
           CAD X/Y/Z map to URDF Z/X/Y; CAD and link origins coincide.
           Inertia at COM is converted from g mm^2 to kg m^2, then scaled
           assuming the added mass follows the CAD mass distribution; COM is unchanged. -->
      <xacro:property name="right_link5_inertia_scale" value="${(2.580937 + 0.5) / 2.580937}"/>
      <inertial>
        <origin xyz="0.003961 -0.025956 0.151636" rpy="0 0 0"/>
        <mass value="${2.580937 + 0.5}"/>
        <inertia ixx="${0.014890000000 * right_link5_inertia_scale}" ixy="${0.000007623647 * right_link5_inertia_scale}" ixz="${-0.000082304091 * right_link5_inertia_scale}"
                 iyy="${0.014170000000 * right_link5_inertia_scale}" iyz="${0.000764900000 * right_link5_inertia_scale}" izz="${0.002350000000 * right_link5_inertia_scale}"/>
      </inertial>
    </link>
    <!-- J4: knee pitch, Link4 -> Link5 -->
    <joint name="right_joint4" type="revolute">
      <parent link="right_link4"/><child link="right_link5"/><origin xyz="0 0.012 0.147"/><axis xyz="0 1 0"/>
      <limit lower="${-90 * pi / 180}" upper="${2 * pi / 180}" effort="40" velocity="5.23599"/>
      <dynamics damping="2.5" friction="0.05"/>
    </joint>

    <link name="right_link6">
      <xacro:right_link_mesh visual_filename="package://openleg_description/meshes/right_leg/Right_Link6.stl" collision_filename="package://openleg_description/meshes/right_leg/Right_Link6.stl" xyz="0 0 0" rpy="0 0 ${pi}" scale="1 1 1" material="joint_dark"/>
      <!-- CAD mass: 0.079708 kg; Link6 has no added bolts/wires allowance.
           CAD X/Y/Z map to URDF X/-Z/Y; CAD and link origins coincide.
           Inertia at COM is converted from g mm^2 to kg m^2 without mass scaling. -->
      <inertial>
        <origin xyz="0 0.0185 -1.366e-13" rpy="0 0 0"/>
        <mass value="0.079708"/>
        <inertia ixx="0.000009707245" ixy="6.107e-16" ixz="7.369e-17"
                 iyy="0.000006538190" iyz="0" izz="0.000014154792"/>
      </inertial>
    </link>
    <!-- J5: toes pitch, Link5 -> Link6 -->
    <joint name="right_joint5" type="revolute">
      <parent link="right_link5"/><child link="right_link6"/><origin xyz="0 -0.0475 0.27"/><axis xyz="0 1 0"/>
      <limit lower="${-25 * pi / 180}" upper="${20 * pi / 180}" effort="30" velocity="4.18879"/>
      <dynamics damping="2.0" friction="0.04"/>
    </joint>

    <link name="right_link7">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 -${pi / 2}"/>
        <geometry><mesh filename="package://openleg_description/meshes/right_leg/Link7.stl" scale="1 1 1"/></geometry>
        <material name="foot_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 -${pi / 2}"/>
        <geometry><mesh filename="package://openleg_description/meshes/right_leg/Link7.stl" scale="1 1 1"/></geometry>
      </collision>
      <!-- CAD mass: 0.714171 kg, plus 0.5 kg for bolts and wires.
           CAD X/Y/Z map to URDF -Y/-Z/X; CAD and link origins coincide.
           Inertia at COM is converted from g mm^2 to kg m^2, then scaled
           assuming the added mass follows the CAD mass distribution; COM is unchanged. -->
      <xacro:property name="right_link7_inertia_scale" value="${(0.714171 + 0.5) / 0.714171}"/>
      <inertial>
        <origin xyz="-0.019854 0 0.021463" rpy="0 0 0"/>
        <mass value="${0.714171 + 0.5}"/>
        <inertia ixx="${0.000589000000 * right_link7_inertia_scale}" ixy="${-0.000000072115 * right_link7_inertia_scale}" ixz="${-0.000112700000 * right_link7_inertia_scale}"
                 iyy="${0.001700000000 * right_link7_inertia_scale}" iyz="${0.000000004097 * right_link7_inertia_scale}" izz="${0.002004000000 * right_link7_inertia_scale}"/>
      </inertial>
    </link>
    <!-- J6: toes roll, Link6 -> Link7 -->
    <joint name="right_joint6" type="revolute">
      <parent link="right_link6"/><child link="right_link7"/><origin xyz="0.015 0.0185 0.00"/><axis xyz="1 0 0"/>
      <limit lower="${-15 * pi / 180}" upper="${15 * pi / 180}" effort="30" velocity="4.18879"/>
      <dynamics damping="2.0" friction="0.04"/>
    </joint>

    <gazebo reference="right_link1"><mu1>0.5</mu1><mu2>0.5</mu2><kp>200000</kp><kd>1000</kd><maxVel>0.05</maxVel><minDepth>0.001</minDepth></gazebo>
    <gazebo reference="right_link2"><mu1>0.5</mu1><mu2>0.5</mu2><kp>200000</kp><kd>1000</kd><maxVel>0.05</maxVel><minDepth>0.001</minDepth></gazebo>
    <gazebo reference="right_link3"><mu1>0.5</mu1><mu2>0.5</mu2><kp>200000</kp><kd>1000</kd><maxVel>0.05</maxVel><minDepth>0.001</minDepth></gazebo>
    <gazebo reference="right_link4"><mu1>0.5</mu1><mu2>0.5</mu2><kp>200000</kp><kd>1000</kd><maxVel>0.05</maxVel><minDepth>0.001</minDepth></gazebo>
    <gazebo reference="right_link5"><mu1>0.5</mu1><mu2>0.5</mu2><kp>200000</kp><kd>1000</kd><maxVel>0.05</maxVel><minDepth>0.001</minDepth></gazebo>
    <gazebo reference="right_link6"><mu1>0.5</mu1><mu2>0.5</mu2><kp>200000</kp><kd>1000</kd><maxVel>0.05</maxVel><minDepth>0.001</minDepth></gazebo>
    <!-- TPU sole: both tangential friction directions use the shared foot_friction estimate. -->
    <gazebo reference="right_link7"><mu1>${foot_friction}</mu1><mu2>${foot_friction}</mu2><kp>200000</kp><kd>1000</kd><maxVel>0.05</maxVel><minDepth>0.001</minDepth></gazebo>
  </xacro:macro>
</robot>
